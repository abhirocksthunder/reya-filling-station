rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /stations/{stationId}/receipts/{imageId} {
      // Authenticated station members can read original receipt images
      allow read: if request.auth != null;
      // Allow upload if authenticated, file size is under 10MB, and content is an image
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}

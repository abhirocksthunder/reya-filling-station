rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Station Root and all operational subcollections
    // Permissive access for station operations in Chatrai
    match /stations/{stationId} {
      allow read, write: if true;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Station-Scoped Access Control
    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(stationId) {
      return /databases/$(database)/documents/stations/$(stationId)/members/$(request.auth.uid);
    }

    function isMember(stationId) {
      return isSignedIn() && exists(memberDoc(stationId));
    }

    function getMemberData(stationId) {
      return get(memberDoc(stationId)).data;
    }

    function isActive(stationId) {
      return isMember(stationId) && getMemberData(stationId).active == true;
    }

    function isOwner(stationId) {
      return isActive(stationId) && (
        getMemberData(stationId).role == 'owner' ||
        request.auth.token.role == 'owner'
      );
    }

    function isManager(stationId) {
      return isActive(stationId) && (
        getMemberData(stationId).role == 'manager' ||
        isOwner(stationId)
      );
    }

    // Station Root Document
    match /stations/{stationId} {
      allow read: if isActive(stationId);
      allow write: if isOwner(stationId);

      // Station Members (User management & roles)
      match /members/{userId} {
        allow read: if isActive(stationId);
        // Only Station Owner can add, modify, suspend or remove members
        allow write: if isOwner(stationId);
      }

      // Station Configuration (Location, 150m Geofence, Categories)
      match /config/{docId} {
        allow read: if isActive(stationId);
        allow write: if isOwner(stationId);
      }

      // Dynamic Pumps & Dispensers
      match /pumps/{pumpId} {
        allow read: if isActive(stationId);
        allow write: if isOwner(stationId);
      }

      // Nozzle Totalisers & Baselines
      match /nozzles/{nozzleId} {
        allow read: if isActive(stationId);
        allow write: if isOwner(stationId);
      }

      // Fuel Price Versions (Effective-dated, immutable)
      match /priceVersions/{versionId} {
        allow read: if isActive(stationId);
        allow create: if isOwner(stationId);
        allow update, delete: if false; // Immutable!
      }

      // Receipt Templates & Reference Mappings
      match /receiptTemplates/{templateId} {
        allow read: if isActive(stationId);
        allow write: if isOwner(stationId);
      }

      // Operational Shifts
      match /shifts/{shiftId} {
        allow read: if isActive(stationId);
        // Staff can create shift drafts or submit own shift
        allow create: if isActive(stationId) && request.resource.data.staffId == request.auth.uid;
        allow update: if isActive(stationId) && (
          isManager(stationId) ||
          (resource.data.staffId == request.auth.uid && resource.data.status == 'open')
        );
        allow delete: if false;
      }

      // Scan Attempts (Evidence & Candidates) - Append Only
      match /scanAttempts/{attemptId} {
        allow read: if isActive(stationId);
        allow create: if isActive(stationId) && request.resource.data.capturedBy == request.auth.uid;
        allow update, delete: if false; // Append-only audit trail
      }

      // Authoritative Accepted Readings (Protected - Written ONLY by Trusted Backend / Admin SDK)
      match /acceptedReadings/{readingId} {
        allow read: if isActive(stationId);
        allow write: if false; // Clients cannot forge accepted readings!
      }

      // Latest Reading Pointer (Protected - Written ONLY by Trusted Backend / Admin SDK)
      match /latestReadings/{nozzleId} {
        allow read: if isActive(stationId);
        allow write: if false;
      }

      // Financial Transactions / Money Entries
      match /entries/{entryId} {
        allow read: if isActive(stationId);
        allow create: if isActive(stationId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isActive(stationId) && (
          isManager(stationId) ||
          (resource.data.createdBy == request.auth.uid && resource.data.status == 'draft')
        );
        allow delete: if isOwner(stationId);
      }

      // Calibration & Test Volume Entries (5L Test Measure)
      match /testEntries/{testId} {
        allow read: if isActive(stationId);
        allow create: if isActive(stationId);
        allow update, delete: if isManager(stationId);
      }

      // Credit Khata (Customers yet to pay e.g., Sri Sai Travels, School Bus)
      match /creditKhata/{customerId} {
        allow read: if isActive(stationId);
        allow write: if isManager(stationId);

        match /transactions/{txId} {
          allow read: if isActive(stationId);
          allow write: if isManager(stationId);
        }
      }

      // Confidential Financials & Payroll (Restricted to Owner)
      match /sensitivePayroll/{docId} {
        allow read, write: if isOwner(stationId);
      }

      // Audit Trail (Append-Only)
      match /auditEvents/{eventId} {
        allow read: if isManager(stationId);
        allow create: if isActive(stationId);
        allow update, delete: if false; // Immutable!
      }

      // Backend Outbox & Notifications
      match /notifications/{notifId} {
        allow read: if isActive(stationId);
        allow write: if false; // Managed by trusted outbox
      }
    }
  }
}
